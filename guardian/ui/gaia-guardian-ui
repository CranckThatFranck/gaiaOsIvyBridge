#!/usr/bin/env python3
"""
Gaia OS Ivy Bridge Edition - Gaia Guardian AI Interface (PyQt6)
Interface gráfica sob demanda: consome 0 MB de RAM quando fechada e exibe
telemetria do daemon em C (~1 MB RAM), logs de ações e análises do Gemini 3.8 Flash.
"""
import json
import os
import subprocess
import sys
from PyQt6.QtCore import Qt, QTimer, QThread, pyqtSignal
from PyQt6.QtGui import QFont
from PyQt6.QtWidgets import (
    QApplication,
    QFrame,
    QGridLayout,
    QHBoxLayout,
    QLabel,
    QMainWindow,
    QPushButton,
    QTabWidget,
    QTextEdit,
    QVBoxLayout,
    QWidget,
)

STATUS_JSON = "/var/log/gaia-guardian/status.json"
ACTIONS_LOG = "/var/log/gaia-guardian/actions.log"
INSIGHTS_LOG = "/var/log/gaia-guardian/gemini-insights.log"


class AsyncTaskThread(QThread):
    finished_msg = pyqtSignal(str)

    def __init__(self, cmd):
        super().__init__()
        self.cmd = cmd

    def run(self):
        try:
            subprocess.run(self.cmd, check=False, timeout=25)
            self.finished_msg.emit("Concluído com sucesso.")
        except Exception as e:
            self.finished_msg.emit(f"Erro: {e}")


class MetricCard(QFrame):
    def __init__(self, title: str, initial: str = "--"):
        super().__init__()
        self.setStyleSheet(
            """
            QFrame {
                background-color: #111726;
                border: 1px solid #1E293B;
                border-radius: 8px;
                padding: 8px;
            }
            """
        )
        layout = QVBoxLayout(self)
        layout.setContentsMargins(10, 8, 10, 8)
        self.title_lbl = QLabel(title)
        self.title_lbl.setStyleSheet("color: #94A3B8; font-size: 11px; border: none;")
        self.val_lbl = QLabel(initial)
        self.val_lbl.setStyleSheet("color: #38BDF8; font-size: 16px; font-weight: bold; border: none;")
        layout.addWidget(self.title_lbl)
        layout.addWidget(self.val_lbl)

    def set_value(self, text: str, color: str = "#38BDF8"):
        self.val_lbl.setText(text)
        self.val_lbl.setStyleSheet(f"color: {color}; font-size: 16px; font-weight: bold; border: none;")


class GaiaGuardianWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Gaia Guardian AI — Monitor C & Gemini 3.8 Flash (Zero-RAM UI)")
        self.resize(880, 600)
        self.setStyleSheet(
            """
            QMainWindow, QWidget {
                background-color: #0B0F19;
                color: #E2E8F0;
                font-family: 'Sans Serif';
            }
            QTabWidget::pane {
                border: 1px solid #1E293B;
                border-radius: 6px;
                background-color: #0F172A;
            }
            QTabBar::tab {
                background: #1E293B;
                color: #94A3B8;
                padding: 8px 16px;
                margin-right: 4px;
                border-top-left-radius: 6px;
                border-top-right-radius: 6px;
            }
            QTabBar::tab:selected {
                background: #0284C7;
                color: #FFFFFF;
                font-weight: bold;
            }
            QTextEdit {
                background-color: #090D16;
                color: #E2E8F0;
                border: none;
                padding: 10px;
                font-family: 'Monospace';
                font-size: 12px;
            }
            QPushButton {
                background-color: #0284C7;
                color: white;
                border: none;
                border-radius: 6px;
                padding: 8px 14px;
                font-weight: bold;
            }
            QPushButton:hover {
                background-color: #0369A1;
            }
            QPushButton:disabled {
                background-color: #334155;
                color: #94A3B8;
            }
            """
        )

        central = QWidget()
        self.setCentralWidget(central)
        main_layout = QVBoxLayout(central)
        main_layout.setContentsMargins(16, 14, 16, 14)
        main_layout.setSpacing(12)

        # Header
        header_layout = QHBoxLayout()
        title = QLabel("⚡ Gaia Guardian AI — Núcleo Nativo C + Gemini 3.8 Flash")
        title.setStyleSheet("font-size: 17px; font-weight: bold; color: #F8FAFC;")
        self.status_badge = QLabel("Daemon C Ativo (~1 MB RAM)")
        self.status_badge.setStyleSheet(
            "background-color: #064E3B; color: #34D399; padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: bold;"
        )
        header_layout.addWidget(title)
        header_layout.addStretch()
        header_layout.addWidget(self.status_badge)
        main_layout.addLayout(header_layout)

        # Metric Cards Grid
        grid = QGridLayout()
        grid.setSpacing(10)
        self.card_ram = MetricCard("RAM Física Usada")
        self.card_zram = MetricCard("zRAM (zstd)")
        self.card_psi = MetricCard("Pressão PSI (Memória)")
        self.card_temp = MetricCard("Temperatura da CPU")
        self.card_mglru = MetricCard("Kernel MGLRU / PageCluster")
        self.card_daemon = MetricCard("Consumo Daemon C")

        grid.addWidget(self.card_ram, 0, 0)
        grid.addWidget(self.card_zram, 0, 1)
        grid.addWidget(self.card_psi, 0, 2)
        grid.addWidget(self.card_temp, 1, 0)
        grid.addWidget(self.card_mglru, 1, 1)
        grid.addWidget(self.card_daemon, 1, 2)
        main_layout.addLayout(grid)

        # Tabs
        self.tabs = QTabWidget()
        self.gemini_text = QTextEdit()
        self.gemini_text.setReadOnly(True)
        self.actions_text = QTextEdit()
        self.actions_text.setReadOnly(True)

        self.tabs.addTab(self.gemini_text, "✨ Inteligência & Dicas Gemini 3.8 Flash")
        self.tabs.addTab(self.actions_text, "🛡️ Log de Ações do Daemon C")
        main_layout.addWidget(self.tabs, stretch=1)

        # Action Buttons
        btn_layout = QHBoxLayout()
        self.btn_gemini = QPushButton("✨ Solicitar Análise Gemini 3.8 Flash Agora")
        self.btn_gemini.clicked.connect(self.trigger_gemini_analysis)

        self.btn_reclaim = QPushButton("⚡ Otimizar RAM & Caches Agora")
        self.btn_reclaim.setStyleSheet("background-color: #059669;")
        self.btn_reclaim.clicked.connect(self.trigger_ram_reclaim)

        self.btn_refresh = QPushButton("🔄 Atualizar")
        self.btn_refresh.setStyleSheet("background-color: #334155;")
        self.btn_refresh.clicked.connect(self.refresh_all)

        btn_layout.addWidget(self.btn_gemini)
        btn_layout.addWidget(self.btn_reclaim)
        btn_layout.addStretch()
        btn_layout.addWidget(self.btn_refresh)
        main_layout.addLayout(btn_layout)

        self.worker = None
        self.refresh_all()

        self.timer = QTimer(self)
        self.timer.timeout.connect(self.refresh_metrics)
        self.timer.start(2500)

    def refresh_metrics(self):
        if os.path.isfile(STATUS_JSON):
            try:
                with open(STATUS_JSON, "r", encoding="utf-8") as f:
                    s = json.load(f)
                pct = s.get("mem_used_pct", 0.0)
                ram_color = "#34D399" if pct < 75 else ("#FBBF24" if pct < 85 else "#F87171")
                self.card_ram.set_value(
                    f"{s.get('mem_used_mb', 0)} / {s.get('mem_total_mb', 0)} MB ({pct:.1f}%)",
                    ram_color,
                )
                self.card_zram.set_value(
                    f"{s.get('zram_used_mb', 0)} / {s.get('zram_total_mb', 0)} MB",
                    "#38BDF8",
                )
                psi_s = s.get("psi_some_avg10", 0.0)
                psi_f = s.get("psi_full_avg10", 0.0)
                psi_color = "#34D399" if psi_s < 5.0 else "#FBBF24"
                self.card_psi.set_value(f"some={psi_s:.2f}% | full={psi_f:.2f}%", psi_color)

                temp = s.get("cpu_temp_c", 0.0)
                warn = float(s.get("thermal_warn_c", 90.0) or 90.0)
                t_color = "#34D399" if temp < warn - 15 else ("#FBBF24" if temp < warn else "#F87171")
                label = s.get("cpu_label") or "CPU"
                self.card_temp.set_value(f"{temp:.1f} °C  ({label})", t_color)

                self.card_mglru.set_value(f"MGLRU {s.get('mglru_enabled', '0x0007')} | cluster=0", "#A78BFA")
                rss_kb = s.get("daemon_rss_kb", 0)
                self.card_daemon.set_value(f"{rss_kb} KB (~{rss_kb/1024:.1f} MB)", "#34D399")
            except Exception:
                pass

    def refresh_logs(self):
        if os.path.isfile(INSIGHTS_LOG):
            try:
                with open(INSIGHTS_LOG, "r", encoding="utf-8", errors="ignore") as f:
                    content = f.read()
                self.gemini_text.setPlainText(content if content.strip() else "Nenhuma análise registrada ainda.")
                self.gemini_text.verticalScrollBar().setValue(self.gemini_text.verticalScrollBar().maximum())
            except Exception:
                pass
        else:
            self.gemini_text.setPlainText("Clique em 'Solicitar Análise Gemini 3.8 Flash Agora' para gerar o primeiro diagnóstico.")

        if os.path.isfile(ACTIONS_LOG):
            try:
                with open(ACTIONS_LOG, "r", encoding="utf-8", errors="ignore") as f:
                    content = f.read()
                self.actions_text.setPlainText(content)
                self.actions_text.verticalScrollBar().setValue(self.actions_text.verticalScrollBar().maximum())
            except Exception:
                pass

    def refresh_all(self):
        self.refresh_metrics()
        self.refresh_logs()

    def trigger_gemini_analysis(self):
        self.btn_gemini.setEnabled(False)
        self.btn_gemini.setText("⏳ Consultando Gemini 3.8 Flash...")
        self.worker = AsyncTaskThread(["sudo", "/usr/bin/gaia-gemini-advisor", "--reason", "Analise interativa via Gaia Guardian UI"])
        self.worker.finished_msg.connect(self.on_gemini_done)
        self.worker.start()

    def on_gemini_done(self, _msg: str):
        self.btn_gemini.setEnabled(True)
        self.btn_gemini.setText("✨ Solicitar Análise Gemini 3.8 Flash Agora")
        self.refresh_all()
        self.tabs.setCurrentIndex(0)

    def trigger_ram_reclaim(self):
        self.btn_reclaim.setEnabled(False)
        self.btn_reclaim.setText("⏳ Otimizando RAM...")
        self.worker = AsyncTaskThread(["sudo", "killall", "-USR2", "gaia-guardian"])
        self.worker.finished_msg.connect(self.on_reclaim_done)
        self.worker.start()

    def on_reclaim_done(self, _msg: str):
        QTimer.singleShot(600, self._finish_reclaim_ui)

    def _finish_reclaim_ui(self):
        self.btn_reclaim.setEnabled(True)
        self.btn_reclaim.setText("⚡ Otimizar RAM & Caches Agora")
        self.refresh_all()
        self.tabs.setCurrentIndex(1)


if __name__ == "__main__":
    app = QApplication(sys.argv)
    win = GaiaGuardianWindow()
    win.show()
    sys.exit(app.exec())
