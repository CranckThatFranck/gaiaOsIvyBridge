#!/usr/bin/env python3
"""
Gaia OS 1.0 - Consultor Efêmero Inteligente (Gemini 3.8 Flash)
Executa sob demanda em < 3 segundos, toma decisões seguras de otimização
no sistema, grava logs para a interface gráfica e encerra o processo
imediatamente (consumo residente = 0 MB de RAM).
"""
import json
import os
import re
import subprocess
import sys
import time
import urllib.request
import urllib.error
from datetime import datetime

LOG_DIR = "/var/log/gaia-guardian"
ACTIONS_LOG = os.path.join(LOG_DIR, "actions.log")
INSIGHTS_LOG = os.path.join(LOG_DIR, "gemini-insights.log")
LATEST_JSON = os.path.join(LOG_DIR, "latest-gemini.json")
STATUS_JSON = os.path.join(LOG_DIR, "status.json")
MODEL_NAME = "gemini-3.8-flash"


def log_action(level: str, msg: str) -> None:
    os.makedirs(LOG_DIR, exist_ok=True)
    ts = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    with open(ACTIONS_LOG, "a", encoding="utf-8") as f:
        f.write(f"[{ts}] [{level}] {msg}\n")


def load_api_key() -> str:
    if os.environ.get("GEMINI_API_KEY"):
        return os.environ["GEMINI_API_KEY"].strip()

    candidate_files = [
        "/etc/gaiaos/guardian.env",
        "/home/francisco/.bashrc",
    ]
    for path in candidate_files:
        if os.path.isfile(path):
            try:
                with open(path, "r", encoding="utf-8", errors="ignore") as f:
                    for line in f:
                        line = line.strip()
                        if line.startswith("#"):
                            continue
                        m = re.match(r"^(?:export\s+)?GEMINI_API_KEY=['\"]?([^'\"\s]+)['\"]?", line)
                        if m:
                            return m.group(1).strip()
            except OSError:
                pass
    return ""


def collect_snapshot() -> dict:
    status = {}
    if os.path.isfile(STATUS_JSON):
        try:
            with open(STATUS_JSON, "r", encoding="utf-8") as f:
                status = json.load(f)
        except Exception:
            pass

    try:
        top_procs = subprocess.check_output(
            ["ps", "-eo", "pid,ni,comm,%cpu,%mem,rss", "--sort=-rss"],
            text=True,
            timeout=3,
        ).splitlines()[:10]
    except Exception:
        top_procs = []

    try:
        zram_info = subprocess.check_output(
            ["zramctl", "--output-all"], text=True, timeout=3
        ).strip()
    except Exception:
        zram_info = "N/A"

    return {
        "metrics": status,
        "top_processes": top_procs,
        "zram": zram_info,
    }


def execute_safe_decision(decision: dict) -> str:
    action = str(decision.get("action", "none")).strip().lower()
    target_pid = decision.get("target_pid")
    applied = []

    if action in ("drop_clean_cache", "compact_and_drop_cache"):
        try:
            os.sync()
            with open("/proc/sys/vm/drop_caches", "w") as f:
                f.write("1\n")
            applied.append("drop_caches=1 (pagecache limpo liberado)")
        except OSError:
            pass

    if action in ("compact_memory", "compact_and_drop_cache"):
        try:
            with open("/proc/sys/vm/compact_memory", "w") as f:
                f.write("1\n")
            applied.append("compact_memory=1 (desfragmentacao de paginas RAM)")
        except OSError:
            pass

    if action == "renice_process" and isinstance(target_pid, int) and target_pid > 300:
        try:
            comm_path = f"/proc/{target_pid}/comm"
            comm = open(comm_path).read().strip() if os.path.exists(comm_path) else ""
            protected = {"plasmashell", "kwin_wayland", "kwin_x11", "sddm", "Xorg", "gaia-guardian"}
            if comm and comm not in protected:
                os.setpriority(os.PRIO_PROCESS, target_pid, 10)
                applied.append(f"renice +10 aplicado ao PID {target_pid} ({comm})")
        except Exception:
            pass

    if not applied:
        return "Nenhuma intervencao corretiva necessaria (sistema equilibrado)"
    return "; ".join(applied)


def main() -> int:
    reason = "Analise periodica"
    if "--reason" in sys.argv:
        idx = sys.argv.index("--reason")
        if idx + 1 < len(sys.argv):
            reason = sys.argv[idx + 1]

    api_key = load_api_key()
    if not api_key:
        log_action("GEMINI-WARN", "GEMINI_API_KEY nao encontrada para analise do Gemini 3.8 Flash.")
        return 1

    snap = collect_snapshot()
    prompt = f"""Você é o núcleo de inteligência autônoma do Gaia OS Ivy Bridge Edition, num desktop Intel Core i7-3770 (4C/8T, AVX, 16 GiB DDR3, zRAM zstd de cerca de 4 GiB, MGLRU ativo, KDE Plasma Wayland, GPU Intel HD 4000). O alerta térmico padrão é 90 C (TJMax 105 C). Não recomende zRAM de 6 GiB nem descarte agressivo de abas como se a máquina tivesse 6 GiB.
Motivo do acionamento: {reason}

Telemetria em tempo real da máquina:
{json.dumps(snap, ensure_ascii=False, indent=2)}

Retorne APENAS um objeto JSON válido (sem blocos markdown ```json) no seguinte formato exato:
{{
  "status_summary": "Resumo curto de 1 linha sobre a saúde atual (RAM, zRAM, CPU e temperatura)",
  "action": "none | drop_clean_cache | compact_memory | compact_and_drop_cache | renice_process",
  "target_pid": null,
  "decision_rationale": "Explicação concisa em português do porquê dessa decisão técnica",
  "optimization_tips": [
    "Dica prática 1 específica para os processos/métricas atuais desta máquina",
    "Dica prática 2 específica para economizar RAM ou CPU agora"
  ]
}}"""

    url = f"https://generativelanguage.googleapis.com/v1beta/models/{MODEL_NAME}:generateContent?key={api_key}"
    payload = json.dumps({
        "contents": [{"parts": [{"text": prompt}]}],
        "generationConfig": {
            "temperature": 0.2,
            "responseMimeType": "application/json",
        },
    }).encode("utf-8")

    req = urllib.request.Request(url, data=payload, headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            body = json.loads(resp.read().decode("utf-8"))
    except Exception as e:
        log_action("GEMINI-ERR", f"Falha na chamada ao {MODEL_NAME}: {e}")
        return 1

    try:
        raw_text = body["candidates"][0]["content"]["parts"][0]["text"].strip()
        raw_text = re.sub(r"^```(?:json)?\s*|\s*```$", "", raw_text, flags=re.DOTALL).strip()
        decision = json.loads(raw_text)
    except Exception as e:
        log_action("GEMINI-ERR", f"Resposta inesperada do {MODEL_NAME}: {e}")
        return 1

    exec_result = execute_safe_decision(decision)
    ts = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

    record = {
        "timestamp": ts,
        "model": MODEL_NAME,
        "trigger_reason": reason,
        "status_summary": decision.get("status_summary", ""),
        "action": decision.get("action", "none"),
        "executed": exec_result,
        "decision_rationale": decision.get("decision_rationale", ""),
        "optimization_tips": decision.get("optimization_tips", []),
    }

    os.makedirs(LOG_DIR, exist_ok=True)
    with open(LATEST_JSON, "w", encoding="utf-8") as f:
        json.dump(record, f, ensure_ascii=False, indent=2)
    os.chmod(LATEST_JSON, 0o644)

    tips_formatted = "\n".join(f"  • {t}" for t in record["optimization_tips"])
    entry = (
        f"====================================================================\n"
        f"[{ts}] Modelo: {MODEL_NAME} | Gatilho: {reason}\n"
        f"Diagnóstico: {record['status_summary']}\n"
        f"Decisão IA : {record['action']} -> {exec_result}\n"
        f"Justificativa: {record['decision_rationale']}\n"
        f"Dicas de Otimização:\n{tips_formatted}\n"
    )
    with open(INSIGHTS_LOG, "a", encoding="utf-8") as f:
        f.write(entry)
    os.chmod(INSIGHTS_LOG, 0o644)

    log_action(
        "GEMINI-DECISION",
        f"[{MODEL_NAME}] Acao='{record['action']}' ({exec_result}) | {record['status_summary']}",
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
