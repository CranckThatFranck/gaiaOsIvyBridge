[Unit]
Description=Gaia Guardian (telemetria, PSI e temperatura do i7-3770)
After=local-fs.target

[Service]
Type=simple
EnvironmentFile=-/etc/gaiaos/guardian.env
ExecStart=/usr/bin/gaia-guardian
ExecReload=/bin/kill -USR1 $MAINPID
Restart=always
RestartSec=3
MemoryHigh=16M
MemoryMax=32M

[Install]
WantedBy=multi-user.target
