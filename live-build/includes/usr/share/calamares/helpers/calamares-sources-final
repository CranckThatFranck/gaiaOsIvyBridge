#!/bin/sh
# Fontes do sistema instalado: stable + updates + security + backports (pin 100).
CHROOT=$(mount | grep proc | grep calamares | awk '{print $3}' | sed -e "s#/proc##g")
RELEASE="trixie"

cat > "$CHROOT/etc/apt/sources.list" << EOF
# Gaia OS Ivy Bridge Edition — Debian ${RELEASE}
deb https://deb.debian.org/debian ${RELEASE} main contrib non-free-firmware
deb https://deb.debian.org/debian ${RELEASE}-updates main contrib non-free-firmware
deb https://security.debian.org/debian-security ${RELEASE}-security main contrib non-free-firmware
deb https://deb.debian.org/debian ${RELEASE}-backports main contrib non-free-firmware
EOF

mkdir -p "$CHROOT/etc/apt/preferences.d"
cat > "$CHROOT/etc/apt/preferences.d/gaia-backports" << 'EOF'
Package: *
Pin: release a=trixie-backports
Pin-Priority: 100
EOF

exit 0
