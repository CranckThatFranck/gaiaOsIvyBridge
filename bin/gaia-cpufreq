#!/bin/sh
# intel_pstate no i7-3770: balance_performance usa turbo quando o desktop precisa
# e não é o perfil de bateria do notebook Westmere.
for pref in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do
    if [ -w "$pref" ]; then
        echo balance_performance > "$pref" 2>/dev/null || true
    fi
done
exit 0
