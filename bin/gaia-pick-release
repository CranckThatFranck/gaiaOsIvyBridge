#!/usr/bin/env python3
"""Escolhe o gaiaos-core mais novo entre releases cujo tag começa por gaiaos-core-."""
import json
import subprocess
import sys


def load_releases(paths):
    releases = []
    for path in paths:
        with open(path, encoding="utf-8") as handle:
            data = json.load(handle)
        if isinstance(data, list):
            releases.extend(data)
        elif isinstance(data, dict) and "tag_name" in data:
            releases.append(data)
    return releases


def newer(left, right):
    result = subprocess.run(
        ["dpkg", "--compare-versions", left, "gt", right],
        check=False,
    )
    return result.returncode == 0


def pick(releases):
    best = None
    for release in releases:
        tag = release.get("tag_name") or ""
        prefix = "gaiaos-core-"
        if not tag.startswith(prefix):
            continue
        version = tag[len(prefix) :]
        if not version:
            continue
        for asset in release.get("assets") or []:
            name = asset.get("name") or ""
            if not (name.startswith("gaiaos-core_") and name.endswith("_amd64.deb")):
                continue
            digest = asset.get("digest") or ""
            if not digest.startswith("sha256:"):
                continue
            url = asset.get("browser_download_url") or ""
            if not url.startswith("https://"):
                continue
            candidate = (version, url, digest.split(":", 1)[1].strip(), name)
            if best is None or newer(version, best[0]):
                best = candidate
    return best


def main():
    if len(sys.argv) < 2:
        print("uso: gaia-pick-release <releases.json> [mais.json...]", file=sys.stderr)
        return 2
    chosen = pick(load_releases(sys.argv[1:]))
    if not chosen:
        return 1
    print("\n".join(chosen))
    return 0


if __name__ == "__main__":
    sys.exit(main())
