#!/usr/bin/env bash
# Gaia OS Ivy Bridge — atualiza o Debian (segurança, kernel, apps) e o pacote gaiaos-core.
set -euo pipefail

LOG="/var/log/gaia-update.log"
REPO="${GAIA_GITHUB_REPO:-CranckThatFranck/gaiaOsIvyBridge}"
MODE="${1:-}"
AUTO=0
TOOLS=1
FULL=1

mkdir -p "$(dirname "$LOG")"
touch "$LOG"
chmod 644 "$LOG" || true

log() { echo "[$(date -Iseconds)] $*" | tee -a "$LOG"; }

gaia_update_tools() {
    local page=1 part combined pick deb got newver oldver url digest name
    combined="$(mktemp)"
    deb="$(mktemp --suffix=.deb)"
    printf '%s\n' '[]' > "$combined"
    trap 'rm -f "$combined" "$deb"' RETURN

    while [ "$page" -le 5 ]; do
        part="$(mktemp)"
        if ! curl --fail --proto '=https' --tlsv1.2 --silent --show-error --max-time 40 -L \
            -o "$part" "https://api.github.com/repos/${REPO}/releases?per_page=100&page=${page}"; then
            rm -f "$part"
            if [ "$page" -eq 1 ]; then
                log "GitHub releases indisponível; ferramentas locais permanecem"
                return 1
            fi
            break
        fi
        if ! python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); raise SystemExit(0 if isinstance(d, list) and d else 1)' "$part"; then
            rm -f "$part"
            break
        fi
        python3 - "$combined" "$part" <<'PY'
import json, sys
dest, extra = sys.argv[1], sys.argv[2]
current = json.load(open(dest, encoding="utf-8"))
current.extend(json.load(open(extra, encoding="utf-8")))
json.dump(current, open(dest, "w", encoding="utf-8"))
PY
        rm -f "$part"
        page=$((page + 1))
    done

    if ! pick="$(gaia-pick-release "$combined")"; then
        log "nenhuma release gaiaos-core-* com .deb e digest sha256"
        return 1
    fi
    newver="$(printf '%s\n' "$pick" | sed -n '1p')"
    url="$(printf '%s\n' "$pick" | sed -n '2p')"
    digest="$(printf '%s\n' "$pick" | sed -n '3p')"
    name="$(printf '%s\n' "$pick" | sed -n '4p')"
    oldver="$(dpkg-query -W -f='${Version}' gaiaos-core 2>/dev/null || echo 0)"
    if ! dpkg --compare-versions "$newver" gt "$oldver"; then
        log "gaiaos-core $oldver já é atual ($newver)"
        return 0
    fi
    if ! curl --fail --proto '=https' --tlsv1.2 --retry 3 --retry-delay 2 --max-time 180 -L \
        -o "$deb" "$url"; then
        log "falha ao baixar $name"
        return 1
    fi
    got="$(sha256sum "$deb" | awk '{print $1}')"
    if [ "$got" != "$digest" ]; then
        log "checksum sha256 não confere para $name"
        return 1
    fi
    log "instalando gaiaos-core $oldver -> $newver ($name)"
    if dpkg -i "$deb" >>"$LOG" 2>&1 || apt-get "${APT_OPTS[@]}" -y -f install >>"$LOG" 2>&1; then
        return 0
    fi
    log "dpkg não instalou $name"
    return 1
}

case "$MODE" in
    --auto) AUTO=1 ;;
    --security-only) FULL=0; TOOLS=0 ;;
    --tools) FULL=0; TOOLS=1 ;;
    --full|"") ;;
    -h|--help)
        echo "Uso: gaia-update [--auto|--full|--security-only|--tools]"
        exit 0
        ;;
    *)
        echo "Modo desconhecido: $MODE" >&2
        exit 2
        ;;
esac

if [ "$(id -u)" -ne 0 ]; then
    exec sudo -E "$0" "$@"
fi

export DEBIAN_FRONTEND=noninteractive
APT_OPTS=(-o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold)

log "início modo=${MODE:-full}"

if command -v gaia-snapshot >/dev/null 2>&1; then
    gaia-snapshot create "pre-update" >>"$LOG" 2>&1 || log "snapshot falhou; seguindo mesmo assim"
fi

if ! apt-get update >>"$LOG" 2>&1; then
    log "apt-get update falhou (sem rede ou espelho fora). Nada foi alterado além do snapshot."
    if [ "$AUTO" -eq 1 ]; then
        exit 0
    fi
    exit 1
fi

if [ "$FULL" -eq 0 ] && [ "$TOOLS" -eq 0 ]; then
    unattended-upgrade -v >>"$LOG" 2>&1 || log "unattended-upgrade retornou erro"
    log "concluído (somente segurança)"
    exit 0
fi

if command -v unattended-upgrade >/dev/null 2>&1; then
    unattended-upgrade -v >>"$LOG" 2>&1 || log "unattended-upgrade retornou erro"
fi

if [ "$FULL" -eq 1 ]; then
    apt-get "${APT_OPTS[@]}" -y full-upgrade >>"$LOG" 2>&1
    apt-get -y autoremove --purge >/dev/null 2>&1 || true
fi

if [ "$TOOLS" -eq 1 ] && command -v curl >/dev/null 2>&1; then
    if ! gaia_update_tools; then
        log "não foi possível atualizar o gaiaos-core"
        if [ "$AUTO" -eq 0 ]; then
            exit 1
        fi
    fi
fi

log "concluído"
exit 0
