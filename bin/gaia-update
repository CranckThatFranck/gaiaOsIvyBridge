#!/usr/bin/env bash
# Gaia OS Ivy Bridge — atualiza o Debian (segurança, kernel, apps) e o pacote gaiaos-core.
set -euo pipefail

LOG="/var/log/gaia-update.log"
REPO="${GAIA_GITHUB_REPO:-CranckThatFranck/gaiaOsIvyBridge}"
MODE="${1:-}"
AUTO=0
TOOLS=1
FULL=1

mkdir -p "$(dirname "$LOG")"
touch "$LOG"
chmod 644 "$LOG" || true

log() { echo "[$(date -Iseconds)] $*" | tee -a "$LOG"; }

case "$MODE" in
    --auto) AUTO=1 ;;
    --security-only) FULL=0; TOOLS=0 ;;
    --tools) FULL=0; TOOLS=1 ;;
    --full|"") ;;
    -h|--help)
        echo "Uso: gaia-update [--auto|--full|--security-only|--tools]"
        exit 0
        ;;
    *)
        echo "Modo desconhecido: $MODE" >&2
        exit 2
        ;;
esac

if [ "$(id -u)" -ne 0 ]; then
    exec sudo -E "$0" "$@"
fi

export DEBIAN_FRONTEND=noninteractive
APT_OPTS=(-o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold)

log "início modo=${MODE:-full}"

if command -v gaia-snapshot >/dev/null 2>&1; then
    gaia-snapshot create "pre-update" >>"$LOG" 2>&1 || log "snapshot falhou; seguindo mesmo assim"
fi

if ! apt-get update >>"$LOG" 2>&1; then
    log "apt-get update falhou (sem rede ou espelho fora). Nada foi alterado além do snapshot."
    if [ "$AUTO" -eq 1 ]; then
        exit 0
    fi
    exit 1
fi

if [ "$FULL" -eq 0 ] && [ "$TOOLS" -eq 0 ]; then
    unattended-upgrade -v >>"$LOG" 2>&1 || log "unattended-upgrade retornou erro"
    log "concluído (somente segurança)"
    exit 0
fi

if command -v unattended-upgrade >/dev/null 2>&1; then
    unattended-upgrade -v >>"$LOG" 2>&1 || log "unattended-upgrade retornou erro"
fi

if [ "$FULL" -eq 1 ]; then
    apt-get "${APT_OPTS[@]}" -y full-upgrade >>"$LOG" 2>&1
    apt-get -y autoremove --purge >/dev/null 2>&1 || true
fi

if [ "$TOOLS" -eq 1 ] && command -v curl >/dev/null 2>&1; then
    tmp="$(mktemp)"
    if curl -fsSL --max-time 40 "https://api.github.com/repos/${REPO}/releases/latest" -o "$tmp"; then
        url="$(python3 - "$tmp" <<'PY'
import json, sys
data = json.load(open(sys.argv[1], encoding="utf-8"))
for asset in data.get("assets", []):
    name = asset.get("name", "")
    if name.startswith("gaiaos-core_") and name.endswith("_amd64.deb"):
        print(asset.get("browser_download_url", ""))
        break
PY
)"
        if [ -n "$url" ]; then
            deb="/tmp/$(basename "$url")"
            curl -fL --max-time 180 -o "$deb" "$url"
            newver="$(dpkg-deb -f "$deb" Version)"
            oldver="$(dpkg-query -W -f='${Version}' gaiaos-core 2>/dev/null || echo 0)"
            if dpkg --compare-versions "$newver" gt "$oldver"; then
                log "instalando gaiaos-core $oldver -> $newver"
                dpkg -i "$deb" >>"$LOG" 2>&1 || apt-get "${APT_OPTS[@]}" -y -f install >>"$LOG" 2>&1
            else
                log "gaiaos-core $oldver já é atual ($newver)"
            fi
            rm -f "$deb"
        else
            log "release sem asset gaiaos-core_*.deb; ferramentas locais permanecem"
        fi
    else
        log "GitHub releases indisponível; ferramentas locais permanecem"
    fi
    rm -f "$tmp"
fi

log "concluído"
exit 0
