#!/usr/bin/env bash
# Serviços enxutos no desktop Ivy Bridge: sem modem, Docker sob demanda se existir.
# fwupd permanece disponível (a placa é UEFI). Não há o mascaramento do notebook.
set -euo pipefail

if [ -n "${GAIA_ROOT:-}" ] && [ -f "${GAIA_ROOT}/performance/gaia-chrome-performance.json" ]; then
    SOURCE="$GAIA_ROOT"
elif [ -f /usr/share/gaiaos/performance/gaia-chrome-performance.json ]; then
    SOURCE=/usr/share/gaiaos
else
    SOURCE="$(cd "$(dirname "$0")/.." && pwd)"
fi

as_root() {
    if [ "$(id -u)" -eq 0 ]; then "$@"; else sudo "$@"; fi
}

echo "[gaia-lean-services] Política de memória do Chrome (moderada, 16 GiB)..."
as_root mkdir -p /etc/opt/chrome/policies/managed
as_root cp "$SOURCE/performance/gaia-chrome-performance.json" /etc/opt/chrome/policies/managed/gaia-performance.json
as_root chmod 644 /etc/opt/chrome/policies/managed/gaia-performance.json

if systemctl list-unit-files docker.service >/dev/null 2>&1; then
    echo "[gaia-lean-services] Docker em socket activation..."
    as_root systemctl disable --now docker.service 2>/dev/null || true
    as_root systemctl enable --now docker.socket 2>/dev/null || true
else
    echo "[gaia-lean-services] Docker não está instalado; nada a converter."
fi

echo "[gaia-lean-services] Sem modem celular neste desktop: ModemManager fica desligado se existir."
as_root systemctl disable --now ModemManager.service 2>/dev/null || true
as_root systemctl mask ModemManager.service 2>/dev/null || true

echo "[gaia-lean-services] Concluído. fwupd não foi mascarado."
